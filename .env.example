# ================================================================
# LLM Configuration (via LiteLLM / LiteLLM Proxy)
# ================================================================
LITELLM_PROXY_URL=
LITELLM_MODEL=google/gemini-3-flash-preview
LITELLM_API_KEY=

# ================================================================
# SMTP Configuration
# ================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jkritik8@gmail.com
# For Gmail, use a 16-character App Password (not your normal Google account password)
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ================================================================
# Sending Policy & Rate Limiting (Conservative pacing)
# ================================================================
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
MAX_EMAILS_PER_RUN=100

# ================================================================
# Test Address (Used by `python main.py test-email`)
# ================================================================
TEST_EMAIL=jkritik8@gmail.com
